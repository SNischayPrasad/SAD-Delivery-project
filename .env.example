# Tally configuration. Copy this file to .env and uncomment what you need.
# `npm start` reads .env automatically. Every setting is optional.

# HTTP port.
# PORT=3000

# Where the database and uploaded files live. Default: the "data" folder in the project.
# DATA_DIR=C:\TallyData

# How long a sign-in lasts, in hours (default 168 = 7 days, at most 87600 = 10 years).
# SESSION_TTL_HOURS=168

# Upload limits. The admin and staff apps read these from the server after sign-in.
# Out-of-range values are ignored with a warning and the default is used.
# MAX_INVOICE_MB=20           (at most 1024)
# MAX_PHOTO_MB=15             (at most 1024)
# MAX_PHOTOS_PER_UPLOAD=10    (whole number, 1 to 100)

# First admin account. Only used when the database has no admin yet (the very first run).
# Set a strong password here BEFORE the first start, or change it in the app afterwards.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123

# Invoice reading:
#   auto   = use Claude when ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN is set, otherwise read locally
#   local  = never send invoices to Claude
#   claude = use Claude, fall back to local reading if it fails
# EXTRACTOR=auto
# CLAUDE_MODEL=claude-opus-5

# Setting a key enables AI extraction in "auto" mode. Uploaded invoice files are then sent to the Anthropic API.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
